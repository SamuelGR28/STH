rules_version = '2';

// Reglas de seguridad de STH.
// Copia todo este archivo en: Consola de Firebase > Firestore Database > Reglas > Publicar.
// Cambia el correo de la lista "esAdmin" por el del dueño de la tienda
// (debe ser el mismo que pusiste en js/config.js > administradores).
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esAdmin() {
      // No exige correo verificado: la cuenta del dueño ya existe y Firebase
      // no permite crear otra cuenta con el mismo correo.
      return conSesion()
        && request.auth.token.email in ['samuelgira237@gmail.com', 'copiala29@gmail.com'];
    }

    // Precios: solo los ven usuarios con sesión; solo el administrador los cambia.
    match /precios/{doc} {
      allow read: if conSesion();
      allow write: if esAdmin();
    }

    // Productos y ajustes del catálogo: los ve cualquiera; solo el administrador los cambia.
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
      // Un cliente con sesión solo puede BAJAR las unidades disponibles al enviar un pedido
      // (máximo 50 por pedido). No puede cambiar nada más del producto.
      allow update: if conSesion()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && resource.data.stock - request.resource.data.stock <= 50;
    }
    // Inventario: historial de movimientos. Solo el administrador lo ve.
    // Un cliente con sesión solo puede registrar la salida de su propio pedido web.
    match /movimientos/{id} {
      allow read, update, delete: if esAdmin();
      allow create: if esAdmin() || (conSesion()
        && request.resource.data.tipo == 'pedido'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad < 0
        && request.resource.data.cantidad >= -50);
    }

    match /fotos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /ajustes/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Perfil de cada cliente: cada uno ve y edita solo el suyo.
    match /usuarios/{uid} {
      allow read, write: if conSesion() && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
