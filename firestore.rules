rules_version = '2';

// Reglas de seguridad de SJTS.
// Copia todo este archivo en: Consola de Firebase > Firestore Database > Reglas > Publicar.
// Los correos de "esAdmin" deben ser los mismos de js/config.js > administradores.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esAdmin() {
      // No exige correo verificado: las cuentas de administrador ya existen y Firebase
      // no permite crear otra cuenta con el mismo correo.
      return conSesion()
        && request.auth.token.email in ['samuelgira237@gmail.com', 'copiala29@gmail.com'];
    }

    // Precios: solo los ven usuarios con sesión; solo el administrador los cambia.
    match /precios/{doc} {
      allow read: if conSesion();
      allow write: if esAdmin();
    }

    // Productos (incluye las unidades del inventario): los ve cualquiera;
    // solo el administrador los cambia.
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Pedidos con token. El cliente con sesión crea su pedido como "pendiente"
    // y puede ver solo los suyos. El administrador los ve todos y decide
    // si "compró" (se descuenta del inventario) o "no compró".
    match /pedidos/{token} {
      allow read: if esAdmin() || (conSesion() && resource.data.uid == request.auth.uid);
      allow create: if conSesion()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.token == token
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
      allow update, delete: if esAdmin();
    }

    // Inventario: historial de movimientos. Solo el administrador.
    match /movimientos/{id} {
      allow read, write: if esAdmin();
    }

    match /fotos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /ajustes/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Perfil de cada cliente: cada uno ve y edita solo el suyo.
    match /usuarios/{uid} {
      allow read, write: if conSesion() && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
