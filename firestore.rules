rules_version = '2';

// Reglas de seguridad de STH.
// Copia todo este archivo en: Consola de Firebase > Firestore Database > Reglas > Publicar.
// Cambia el correo de la lista "esAdmin" por el del dueño de la tienda
// (debe ser el mismo que pusiste en js/config.js > administradores).
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esAdmin() {
      return conSesion()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['samuelgira237@gmail.com'];
    }

    // Precios: solo los ven usuarios con sesión; solo el administrador los cambia.
    match /precios/{doc} {
      allow read: if conSesion();
      allow write: if esAdmin();
    }

    // Perfil de cada cliente: cada uno ve y edita solo el suyo.
    match /usuarios/{uid} {
      allow read, write: if conSesion() && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
